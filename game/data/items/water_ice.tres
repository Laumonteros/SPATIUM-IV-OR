[gd_resource type="Resource" script_class="ItemDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://core/data/item_def.gd" id="1_item"]
[ext_resource type="Script" path="res://core/data/science_source.gd" id="2_sci"]
[ext_resource type="PackedScene" path="res://assets/models/environment/moon/deposit_ice.glb" id="3_model"]

[sub_resource type="Resource" id="Resource_sci"]
script = ExtResource("2_sci")
kind = 0
source_name = "NASA LCROSS (Colaprete et al., Science 330, 2010)"
url = "https://science.nasa.gov/mission/lcross/"
date = "2010-10-22"
units = "% en masa"
notes = "El impacto de LCROSS en el cráter Cabeus (polo sur) en 2009 detectó agua en el material expulsado: alrededor de 5,6 ± 2,9 % en masa. El cráter Albor del juego es ficticio; su hielo es una ubicación de juego."

[resource]
script = ExtResource("1_item")
category = 1
max_stack = 999
unit_mass_kg = 2.0
utility_key = "ITEM_WATER_ICE_UTILITY"
location_key = "ITEM_WATER_ICE_LOCATION"
scientific_value = 80
fabrication_value = 60
world_scene = ExtResource("3_model")
science = SubResource("Resource_sci")
id = &"water_ice"
name_key = "ITEM_WATER_ICE_NAME"
description_key = "ITEM_WATER_ICE_DESC"
