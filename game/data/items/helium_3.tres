[ext_resource type="PackedScene" path="res://assets/models/environment/moon/deposit_regolith.glb" id="3_model"]

[sub_resource type="Resource" id="Resource_sci"]
script = ExtResource("2_sci")
kind = 1
source_name = "Wittenberg, Santarius y Kulcinski (1986), Fusion Technology 10; muestras Apolo"
url = "https://www.lpi.usra.edu/publications/books/lunar_sourcebook/"
date = "1986"
units = "partes por mil millones (ppb)"
notes = "El viento solar implanta helio-3 en los granos del regolito; las muestras Apolo muestran concentraciones de pocas a decenas de partes por mil millones, más altas en suelos ricos en ilmenita. La fusión con helio-3 aún no existe: la celda experimental del juego es tecnología futura y su rendimiento es un valor de juego."

[resource]
script = ExtResource("1_item")
category = 0
max_stack = 999
unit_mass_kg = 0.5
utility_key = "ITEM_HELIUM_3_UTILITY"
location_key = "ITEM_HELIUM_3_LOCATION"
scientific_value = 95
fabrication_value = 40
world_scene = ExtResource("3_model")
science = SubResource("Resource_sci")
id = &"helium_3"
name_key = "ITEM_HELIUM_3_NAME"
description_key = "ITEM_HELIUM_3_DESC"
