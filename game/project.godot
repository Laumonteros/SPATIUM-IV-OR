; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SPATIUM IV"
config/description="Videojuego 3D de exploración espacial, construcción, supervivencia e investigación científica. NASA Space Apps Challenge 2026: Build a Junior Astronaut Mission Trainer."
config/version="0.7.0"
run/main_scene="res://main/game_session.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.03, 0.05, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Settings="*res://autoload/settings.gd"
InputConfig="*res://autoload/input_config.gd"
DataRegistry="*res://autoload/data_registry.gd"
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
CurvedWorld="*res://autoload/curved_world.gd"

[shader_globals]

planet_curvature={
"type": "float",
"value": 0.0
}

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.es.translation", "res://localization/strings.en.translation")
locale/fallback="es"

[layer_names]

3d_physics/layer_1="terreno"
3d_physics/layer_2="jugador"
3d_physics/layer_3="estructuras"
3d_physics/layer_4="recursos"
3d_physics/layer_5="interactuables"
3d_physics/layer_6="vehiculos"
3d_physics/layer_7="fantasma_construccion"
3d_physics/layer_8="zonas"
3d_physics/layer_9="mobiliario"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=1.62

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.02, 1)
anti_aliasing/quality/screen_space_aa=1
